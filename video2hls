class CustomFormatter(
    argparse.RawDescriptionHelpFormatter, argparse.ArgumentDefaultsHelpFormatter
):
    pass


def ratio(value: str) -> float:
    """Turn a ratio like 16:9 into a number."""
    num, den = (int(x) for x in value.split(":", 1))
    return num / den


