Stream = dict[str, Any]
Chapter = dict[str, Any]


class Technical(TypedDict):
    """Technical information extracted from the input video."""

    video: Stream
    audios: list[Stream]
    chapters: list[Chapter]


class Playlist(TypedDict):
    """A media playlist to be referenced in the master playlist."""

    name: str
    resolution: str


