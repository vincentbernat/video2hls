class ColorizingStreamHandler(logging.StreamHandler):
    """Provide a nicer logging output to error output with colors."""

    color_map: Mapping[str, int] = MappingProxyType(
        {
            x: i
            for i, x in enumerate(
                ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
            )
        }
    )
    level_map: Mapping[int, tuple[str | None, str, str]] = MappingProxyType(
        {
            logging.DEBUG: (None, "blue", " DBG"),
            logging.INFO: (None, "green", "INFO"),
            logging.WARNING: (None, "yellow", "WARN"),
            logging.ERROR: (None, "red", " ERR"),
            logging.CRITICAL: ("red", "white", "CRIT"),
        }
    )
    csi = "\x1b["
    reset = "\x1b[0m"

    @property
    def is_tty(self) -> bool:
        isatty = getattr(self.stream, "isatty", None)
        return bool(isatty and isatty())

    def format(self, record: logging.LogRecord) -> str:
        message = super().format(record)
        params: list[str] = []
        levelno = record.levelno
        if levelno not in self.level_map:
            levelno = logging.WARNING
        bg, fg, level = self.level_map[levelno]
        if bg is not None and bg in self.color_map:
            params.append(str(self.color_map[bg] + 40))
        if fg in self.color_map:
            params.append(str(self.color_map[fg] + 30))
        params.append("1m")
        level = f"[{level}]"
        prefix = (
            "".join((self.csi, ";".join(params), level, self.reset))
            if self.is_tty
            else level
        )
        return "\n".join(f"{prefix}: {line}" for line in message.split("\n"))


def setup_logging(options: Options) -> None:
    """Configure logging."""
    root = logging.getLogger("")
    root.setLevel(logging.WARNING)
    logger.setLevel(logging.DEBUG if options.debug else logging.INFO)
    if not options.silent:
        root.addHandler(ColorizingStreamHandler())


def run(options: Options, what: str, *args: str) -> str:
    """Execute either ffmpeg or ffprobe with the provided arguments.

    Comments are filtered out, except when displaying to user.

    """
    if what in {"ffprobe", "ffmpeg"}:
        what = getattr(options, what)

    # Pretty format arguments
    jargs: list[str] = []
    for arg in args:
        if arg.startswith("# "):
            jargs.append(f"`{arg}`")
        else:
            if not jargs or jargs[-1].startswith("`"):
                jargs.append(f" {shlex.quote(arg)}")
            else:
                jargs[-1] += f" {shlex.quote(arg)}"
    if jargs and jargs[0].startswith("`"):
        jargs.insert(0, "")
    pretty = " \\\n   ".join(jargs)
    logger.debug(f"execute {what} {pretty}")

    proc = subprocess.run(
        [what] + [arg for arg in args if not arg.startswith("# ")],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        encoding="utf-8",
        errors="replace",
        check=False,
    )

    if proc.returncode != 0:
        out = "\n".join(f" O: {line}" for line in proc.stdout.rstrip().split("\n"))
        err = "\n".join(f" E: {line}" for line in proc.stderr.rstrip().split("\n"))
        logger.error(f"{what} error:\n A: {pretty}\n{out}\n{err}")
        raise RuntimeError(f"Unable to execute {what}")
    return proc.stdout


def probe(options: Options) -> Technical:
    """Probe input file to extract technical information.

    We only keep the first video stream. This may not be the "best"
    stream ffmpeg would select. All the audio streams are kept.

    """
    logger.info(f"probe {options.input}")
    out = run(
        options,
        "ffprobe",
        "# don't display any status message",
        "-v",
        "quiet",
        "# JSON output",
        "-print_format",
        "json",
        "# get stream and chapter information",
        "-show_entries",
        "format=duration:streams:chapters",
        "# input video",
        options.input,
    )
    info = json.loads(out)
    streams = info.get("streams")

    # Only keep first video, but every audio track
    video_stream: Stream | None = next(
        (x for x in streams if x["codec_type"] == "video"), None
    )
    audio_streams: list[Stream] = [x for x in streams if x["codec_type"] == "audio"]
    if not options.audio:
        audio_streams = []
    if video_stream is None:
        raise RuntimeError(f"no video track in {options.input}")

    _par = video_stream.get("sample_aspect_ratio", "1:1")
    _n, _d = map(int, _par.split(":"))
    par = _n / _d
    video_stream["pixel_aspect_ratio"] = par
    if "duration" not in video_stream and "format" in info:
        video_stream["duration"] = info["format"].get("duration")
    return {
        "video": video_stream,
        "audios": audio_streams,
        "chapters": info.get("chapters", []),
    }


def extract_codecs(options: Options, *samples: str) -> str | None:
    """Extract codecs information from the given MP4 samples.

    ffprobe 8.1 and later provide the codec strings. Older versions
    need them to be built from the codec extradata. Return nothing
    when a stream stays unknown as the result has to cover them all.
    See RFC 6381, section 3.3 and this SO question:
    https://stackoverflow.com/questions/16363167/html5-video-tag-codecs-attribute#16365526

    """
    codecs: list[str] = []
    for sample in samples:
        out = run(
            options,
            "ffprobe",
            "# don't display any status message",
            "-v",
            "quiet",
            "# JSON output",
            "-print_format",
            "json",
            "# also dump the extradata of each stream",
            "-show_data",
            "# get codec information of each stream",
            "-show_entries",
            "stream=index,codec_type,codec_name,mime_codec_string,extradata",
            "# MP4 sample",
            sample,
        )
        for stream in json.loads(out).get("streams", []):
            if stream["codec_type"] not in {"video", "audio"}:
                continue
            codec = stream.get("mime_codec_string") or codec_from_extradata(stream)
            if not codec:
                logger.warning(
                    f"cannot extract codec of track {stream['index']} "
                    f"({stream['codec_name']}) in {sample}"
                )
                return None
            logger.debug(f"found codec {codec} in {sample}")
            codecs.append(codec)
    return ",".join(codecs)


def codec_from_extradata(stream: Stream) -> str | None:
    """Build the codec string of a stream from its extradata.

    Only H.264 and AAC are handled. The extradata comes as a hex dump.
    For H.264, the profile, the constraints and the level are the
    bytes following the version of the AVC configuration. For AAC, the
    object type is in the first bits of the audio specific config.

    """
    dump_re = re.compile(r"^[0-9a-f]{8}: ((?:[0-9a-f]{2,4} )+)", re.MULTILINE)
    mo = dump_re.search(stream.get("extradata", ""))
    if not mo:
        return None
    data = bytes.fromhex(mo.group(1).replace(" ", ""))
    codec_name = stream.get("codec_name")
    if codec_name == "h264" and len(data) >= 4:
        return f"avc1.{data[1]:02x}{data[2]:02x}{data[3]:02x}"
    if codec_name == "aac" and data:
        return f"mp4a.40.{data[0] >> 3}"
    return None


def contained_in(original: tuple[int, int], target: tuple[int, int]) -> tuple[int, int]:
    """Return dimension to ensure original video fits inside target."""
    ratio = original[0] / original[1]
    width, height = target
    if width / ratio > height:
        width = int(height * ratio)
    else:
        height = int(width / ratio)
    return (width // 2 * 2, height // 2 * 2)


def language_name(code: str) -> str | None:
    """Get the name of a language, written in this same language."""
    try:
        from babel import Locale, UnknownLocaleError
    except ImportError:
        return None
    try:
        locale = Locale.parse(code.replace("_", "-"), sep="-")
    except (ValueError, UnknownLocaleError):
        return None
    return Locale(locale.language).get_display_name()


def fix_options(options: Options, technical: Technical) -> None:
    """Fix options to remove too great sizes."""
    # If no HLS playlist prefix, use an empty one
    if len(options.hls_playlist_prefix) == 0:
        options.hls_playlist_prefix = [""]

    # Describe each audio track and pick the default one
    audios = technical["audios"]
    options.audio_default = next(
        (
            idx
            for idx, audio in enumerate(audios)
            if audio.get("disposition", {}).get("default")
        ),
        0,
    )
    del options.audio_names[len(audios) :]
    del options.audio_languages[len(audios) :]
    for idx, audio in enumerate(audios):
        tags = {k.lower(): v for k, v in audio.get("tags", {}).items()}
        if idx >= len(options.audio_languages):
            options.audio_languages.append(tags.get("language", "und"))
        if idx >= len(options.audio_names):
            language = options.audio_languages[idx]
            # MP4 stores the track title in the "name" box
            options.audio_names.append(
                tags.get("title")
                or tags.get("name")
                or (language != "und" and (language_name(language) or language))
                or "Audio"
            )
    if len(set(options.audio_names)) != len(options.audio_names):
        # Renditions of a group need distinct names
        options.audio_names = [
            f"{name} ({idx + 1})" for idx, name in enumerate(options.audio_names)
        ]

    # An audio only variant needs a width of 0. With separate audio,
    # each track gets its own width of 0 instead.
    if options.audio_separate:
        options.video_widths.extend([0] * len(audios))
    elif options.audio_only:
        options.video_widths.append(0)

    # If needed, extend/truncate video options to the same length
    video_options = [
        option
        for option in vars(options)
        if option.startswith("video_") and option.endswith("s")
    ]
    length = len(options.video_widths)
    for option in video_options:
        value = vars(options)[option]
        del value[length:]
        if option == "video_names":
            continue
        if option == "video_presets" and not value:
            continue
        diff = length - len(value)
        if diff > 0:
            # Copy last value
            value.extend([value[-1]] * diff)

    # Fix bitrate when width is 0
    for idx, width in enumerate(options.video_widths):
        if width == 0:
            options.video_bitrates[idx] = 0

    # Handle video names
    if len(options.video_names) < length:
        diff = length - len(options.video_names)
        more = [
            f"{int(width / options.ratio)}p" if bitrate > 0 else "Audio only"
            for width, bitrate in zip(options.video_widths, options.video_bitrates)
        ]
        options.video_names.extend(more[-diff:])

    # Add bitrate factor to bitrates
    options.video_bitrates = [
        int(r * options.video_bitrate_factor) for r in options.video_bitrates
    ]
    if options.mp4_bitrate:
        options.mp4_bitrate = int(options.mp4_bitrate * options.video_bitrate_factor)

    # Adapt options depending on video size
    width = technical["video"]["width"]
    height = technical["video"]["height"]
    par = technical["video"]["pixel_aspect_ratio"]
    for idx in reversed(range(len(options.video_widths))):
        if (options.video_widths[idx] > par * width * 1.1) and (
            options.video_widths[idx] * height / width > height * 1.1
        ):
            logger.warning(f"skip {options.video_widths[idx]} width")
            for option in video_options:
                try:
                    del getattr(options, option)[idx]
                except IndexError:
                    # May happen for video_presets
                    pass
    # When every width is above the maximum, fall back to the smallest
    # one as it is the closest to what was asked.
    if not options.poster_width:
        options.poster_width = max(
            (w for w in options.video_widths if w <= options.poster_max_width),
            default=min(options.video_widths),
        )
    if not options.mp4_width:
        options.mp4_width = max(
            (w for w in options.video_widths if w <= options.mp4_max_width),
            default=min(options.video_widths),
        )
    if not options.mp4_bitrate:
        options.mp4_bitrate = int(
            options.video_bitrates[options.video_widths.index(options.mp4_width)]
            * options.mp4_bitrate_factor
        )


def poster(options: Options, technical: Technical) -> None:
    """Create poster."""
    if not options.poster:
        logger.debug("skip poster creation")
        return
    logger.debug("create poster")

    # Determine position
    mo = re.match(r"(?:(?P<percent>\d+)%|(?P<seconds>\d+)s)", options.poster_seek)
    if not mo:
        raise RuntimeError(f"invalid value for poster seek: {options.poster_seek}")
    if mo.group("percent"):
        percent = int(mo.group("percent"))
        seek = int(float(technical["video"]["duration"]) * percent / 100)
    else:
        seek = int(mo.group("seconds"))
    logger.debug(f"seek position for poster is {seek}s")

    # Filter to apply
    vfilter = ["select=eq(pict_type\\,I)"]
    resolution = int(options.poster_width / options.ratio)
    twidth, theight = contained_in(
        (int(technical["video"]["width"]), int(technical["video"]["height"])),
        (options.poster_width, resolution),
    )
    vfilter.append(f"scale={twidth}:{theight}")
    logger.info(f"poster is {twidth}x{theight}")
    if options.poster_grayscale:
        vfilter.append("format=gray")

    # Quality
    quality = options.poster_quality * 30 // 100
    quality = 30 - quality + 1

    args = (
        f"# seek to the given position ({options.poster_seek})",
        "-ss",
        f"{seek}",
        "# load input file",
        "-i",
        f"{options.input}",
        "# only keep first video stream",
        "-map",
        f'0:{technical["video"]["index"]}',
        "# take only one frame",
        "-frames:v",
        "1",
        "# filter to select an I-frame and scale",
        "-vf",
        ",".join(vfilter),
        f"# request a JPEG quality ~ {options.poster_quality}",
        "-qscale:v",
        f"{quality}",
        "# output file",
        options.poster_filename,
    )
    run(
        options,
        "ffmpeg",
        "# only log errors",
        "-loglevel",
        "error",
        "-hide_banner",
        *args,
    )


def webvtt_timestamp(seconds: float) -> str:
    """Turn a number of seconds into a WebVTT timestamp."""
    milliseconds = round(seconds * 1000)
    milliseconds, ms = divmod(milliseconds, 1000)
    minutes, s = divmod(milliseconds, 60)
    h, m = divmod(minutes, 60)
    return f"{h:02}:{m:02}:{s:02}.{ms:03}"


def webvtt_text(text: str) -> str:
    """Escape a chapter title for use in a WebVTT cue.

    A cue payload treats ``<`` as the start of a tag and ``&`` as the
    start of an escape. A blank line ends the cue and ``-->`` would be
    read as a new timing line, so newlines are folded into spaces.

    """
    return html.escape(" ".join(text.split()), quote=False)


def chapters(options: Options, technical: Technical) -> None:
    """Create WebVTT chapter file."""
    if not options.chapters:
        logger.debug("skip chapter file creation")
        return
    if not technical["chapters"]:
        logger.debug("no chapter in input video")
        return

    cues: list[tuple[float, float, str]] = []
    seen: set[tuple[float, float]] = set()
    for chapter in technical["chapters"]:
        start = float(chapter["start_time"])
        end = float(chapter["end_time"])
        if end <= start:
            logger.warning(f"skip empty chapter at {start}s")
            continue
        # An MP4 may store its chapters twice, both as a text track
        # and in a "chpl" box, so the same range shows up twice.
        if (start, end) in seen:
            logger.debug(f"skip duplicate chapter at {start}s")
            continue
        seen.add((start, end))
        title = chapter.get("tags", {}).get("title", "")
        title = webvtt_text(title) or f"Chapter {len(cues) + 1}"
        cues.append((start, end, title))

    if not cues:
        logger.debug("no usable chapter in input video")
        return

    logger.info(f"write {len(cues)} chapters to {options.chapters_filename}")
    with open(options.chapters_filename, "w", encoding="utf-8") as f:
        f.write("WEBVTT\n")
        for idx, (start, end, title) in enumerate(cues):
            f.write(
                f"\n{idx + 1}\n"
                f"{webvtt_timestamp(start)} --> {webvtt_timestamp(end)}\n"
                f"{title}\n"
            )


def transcode(options: Options, technical: Technical) -> None:
    """Create transcoded files."""
    logger.debug("create transcoded files")
    video = technical["video"]
    audios = technical["audios"]

    # Grab interesting facts about video
    height = int(video["height"])
    width = int(video["width"])
    num, den = (int(x) for x in video["r_frame_rate"].split("/"))
    fps = num / den
    logger.info(f"input video is {width}x{height} at {fps:,.2f}fps")
    for idx, audio in enumerate(audios):
        logger.info(
            f'input audio "{options.audio_names[idx]}" is '
            f'{audio["channels"]} channels at {audio["sample_rate"]}Hz'
        )

    # Input video
    args: tuple[str, ...] = ("# input video", "-i", options.input)

    def audio_args(selected: list[int]) -> tuple[str, ...]:
        """Build the arguments to encode the given audio tracks.

        selected holds indexes into the audio track list.

        """
        if not selected:
            return ()
        aargs: tuple[str, ...] = ()
        for pos, aidx in enumerate(selected):
            aargs += (
                "# keep an audio track",
                "-map",
                f'0:{audios[aidx]["index"]}',
                "# set its sampling rate",
                f"-ar:a:{pos}",
                f'{options.audio_sampling or audios[aidx]["sample_rate"]}',
            )
        return aargs + (
            "# select audio codec",
            "-c:a",
            options.audio_codec,
            "# select audio profile",
            "-profile:a",
            options.audio_profile,
            "# set audio bitrate",
            "-b:a",
            f"{options.audio_bitrate}k",
        )

    # CODECS must cover the audio of a variant, even when it is a
    # separate rendition. One track is enough as they share the codec.
    cargs = audio_args([options.audio_default] if audios else [])

    # Progressive MP4
    if options.mp4:
        resolution = int(options.mp4_width / options.ratio)
        twidth, theight = contained_in((width, height), (options.mp4_width, resolution))
        logger.info(
            f"progressive MP4 is {twidth}x{theight} at {options.mp4_bitrate}kbps"
        )
        vfilters = [f"scale={twidth}:{theight}", "format=yuv420p"]
        cfilter = "apply filters: scale"
        if options.mp4_overlay:
            with open("_mp4.txt", "w", encoding="utf-8") as f:
                f.write(
                    options.mp4_overlay.format(
                        width=options.mp4_width,
                        resolution=resolution,
                        bitrate=options.mp4_bitrate,
                        codec=options.mp4_codec,
                        profile=options.mp4_profile,
                    )
                )
            vfilters.insert(
                0,
                "drawtext=x=10: y=10: "
                "textfile=_mp4.txt: fontsize=48: "
                "fontcolor=white@0.5: "
                "borderw=3: bordercolor=black@0.5",
            )
            cfilter = "apply filters: add overlay and scale"
        args += (
            "# start producing a progressive MP4",
            "-f",
            "mp4",
            "# keep the first video track",
            "-map",
            f'0:{video["index"]}',
            f"# {cfilter}",
            "-vf",
            ",".join(vfilters),
            "# repeat the first frame when the video starts after the audio",
            "-fps_mode:v",
            "cfr",
            "# select video codec",
            "-c:v",
            options.mp4_codec,
            "# select video profile and level",
            "-profile:v",
            options.mp4_profile.split("@")[0],
            "-level:v",
            options.mp4_profile.split("@")[1],
            "# set maximum video bitrate",
            "-b:v",
            f"{options.mp4_bitrate}k",
            "-maxrate:v",
            f"{options.mp4_bitrate}k",
            "-bufsize:v",
            f"{options.mp4_bitrate*1.5}k",
        )
        if options.mp4_preset:
            args += ("# set the video preset", "-preset", options.mp4_preset)
        args += audio_args(
            [
                aidx
                for aidx in range(len(audios))
                if options.mp4_all_audio or aidx == options.audio_default
            ]
        )
        args += (
            "# don't copy chapters from the input",
            "-map_chapters",
            "-1",
            "# move index at the beginning",
            "-movflags",
            "+faststart",
            "# output filename",
            options.mp4_filename,
        )

    # HLS
    # Audio tracks to mux in each variant: all of them, or, with
    # separate audio, a single one for each variant without video. The
    # trailing ones are the audio renditions.
    audio_tracks: list[list[int]]
    audio_variants: dict[int, int] = {}
    if options.audio_separate:
        audio_tracks = [
            [options.audio_default] if bitrate == 0 else []
            for bitrate in options.video_bitrates
        ]
        audio_variants = {
            aidx: len(audio_tracks) - len(audios) + aidx for aidx in range(len(audios))
        }
        for aidx, vidx in audio_variants.items():
            audio_tracks[vidx] = [aidx]
    else:
        audio_tracks = [list(range(len(audios)))] * len(options.video_widths)

    playlists: dict[int, Playlist] = {}
    variants = zip(
        options.video_widths,
        options.video_bitrates,
        options.video_codecs,
        options.video_names,
        options.video_profiles,
    )
    for idx, (vwidth, vbitrate, vcodec, vname, vprofile) in enumerate(variants):
        logger.debug(f"setup HLS for {vname}")
        resolution = int(vwidth / options.ratio)
        voptions = {
            "width": vwidth,
            "resolution": resolution,
            "bitrate": vbitrate,
            "codec": vcodec,
            "name": vname,
            "profile": vprofile,
        }
        twidth, theight = contained_in((width, height), (vwidth, resolution))
        vfilters = [f"scale={twidth}:{theight}", "format=yuv420p"]
        cfilter = "apply filters: scale"
        if options.video_overlay:
            with open(f"_{idx}.txt", "w") as f:
                f.write(options.video_overlay.format(**voptions))
            vfilters.insert(
                0,
                "drawtext=x=10: y=10: "
                f"textfile=_{idx}.txt: fontsize=48: "
                "fontcolor=white@0.5: "
                "borderw=3: bordercolor=black@0.5",
            )
            cfilter = "apply filters: add overlay and scale"
        vargs: tuple[str, ...] = ()
        if vbitrate > 0:
            vargs += (
                "# keep the first video track",
                "-map",
                f'0:{video["index"]}',
                f"# {cfilter}",
                "-vf",
                ",".join(vfilters),
                "# select video codec",
                "-c:v",
                vcodec,
                "# select video profile and level",
                "-profile:v",
                vprofile.split("@")[0],
                "-level:v",
                vprofile.split("@")[1],
                "# set maximum video bitrate",
                "-b:v",
                f"{vbitrate}k",
                "-maxrate:v",
                f"{vbitrate}k",
                "-bufsize:v",
                f"{vbitrate*1.5}k",
            )
            if options.video_presets:
                vargs += (
                    "# set the video preset",
                    "-preset",
                    f"{options.video_presets[idx]}",
                )
        else:
            vargs += ("# no video",)
        # HLS options
        args += (
            f"# start producing HLS segments for {resolution}p ({idx})",
            "-f",
            "hls",
            *vargs,
            *audio_args(audio_tracks[idx]),
            "# duration of an HLS segment",
            "-hls_time",
            f"{options.hls_time}",
            "# align all segments for key frames",
            "-force_key_frames:v",
            f"expr:gte(t,n_forced*{options.hls_time})",
            "# set mux delay/preload to 0 (not useful for VOD):",
            "-muxdelay",
            "0",
            "-muxpreload",
            "0",
            "# set HLS playlist type",
            "-hls_playlist_type",
            "vod",
            "# do not limit playlist size",
            "-hls_list_size",
            "0",
            (
                "# use fMP4 (iOS > 10)"
                if options.hls_type == "fmp4"
                else "# use MPEG2-TS (compatible with any iOS)"
            ),
            "-hls_segment_type",
            options.hls_type,
            "# append a base URL to each segment name",
            "-hls_base_url",
            options.hls_segment_prefix,
            "# set pattern for segment filenames",
            "-hls_segment_filename",
            ".".join(
                [
                    options.hls_segments.format(index=f"{idx}_%03d", **voptions),
                    {"mpegts": "ts", "fmp4": "mp4"}[options.hls_type],
                ]
            ),
        )
        if options.hls_type == "fmp4":
            args += (
                "# filename for initial fMP4 segment",
                "-hls_fmp4_init_filename",
                ".".join(
                    [
                        options.hls_segments.format(index=f"{idx}_init", **voptions),
                        "mp4",
                    ]
                ),
            )
        # Output filename
        playlist_name = ".".join(
            [options.hls_segments.format(index=f"{idx}", **voptions), "m3u8"]
        )
        args += (playlist_name,)
        playlists[idx] = {"name": playlist_name, "resolution": f"{twidth}x{theight}"}

        # Small MP4 to extract the video codec. Audio and video need
        # their own file: an output ends as soon as one of its streams
        # is complete and the other one may stay empty.
        if options.hls_add_codecs and vbitrate > 0:
            args += (
                "# also generate a small MP4 to extract the video codec later",
                "-f",
                "mp4",
                "# use same encoding arguments as the normal video:",
                *vargs,
                "# but keep only one frame",
                "-frames:v",
                "1",
                "# put the result into a temporary file",
                f"_{idx}v.mp4",
            )

    # The audio codec is the same for every variant
    if options.hls_add_codecs and audios:
        args += (
            "# also generate a small MP4 to extract the audio codec later",
            "-f",
            "mp4",
            "# use same encoding arguments as the normal audio:",
            *cargs,
            "# but keep only one frame",
            "-frames:a",
            "1",
            "# put the result into a temporary file",
            "_a.mp4",
        )

    logger.info("start transcoding")
    run(
        options,
        "ffmpeg",
        "# only log errors",
        "-loglevel",
        "error",
        "-hide_banner",
        *args,
    )

    logger.info("write master playlist")
    # Advertise the audio tracks only when a player can switch them
    audio_media = options.audio_separate or len(audios) > 1

    def audio_group(gidx: int) -> str:
        """Return the audio rendition group for one playlist prefix.

        Separate audio needs one group per prefix, as the URI of a
        rendition depends on the prefix.

        """
        return f"audio{gidx}" if options.audio_separate and gidx else "audio"

    # Either every output gets its codecs or none of them does
    all_codecs: dict[int, str] = {}
    if options.hls_add_codecs:
        for idx in playlists:
            samples = [f"_{idx}v.mp4"] if options.video_bitrates[idx] > 0 else []
            if audios:
                samples.append("_a.mp4")
            found = extract_codecs(options, *samples)
            if found is None:
                all_codecs = {}
                break
            all_codecs[idx] = found

    with open(options.hls_master_playlist, "w", encoding="utf-8") as master:
        master.write("#EXTM3U\n")
        master.write("#EXT-X-INDEPENDENT-SEGMENTS\n")
        if audio_media:
            # RFC 8216 says:
            #
            #    The EXT-X-MEDIA tag and the AUDIO, VIDEO, and SUBTITLES
            #    attributes of the EXT-X-STREAM-INF tag are backward compatible
            #    to protocol version 1, but playback on older clients may not be
            #    desirable. A server MAY consider indicating an EXT-X-VERSION of
            #    4 or higher in the Master Playlist but is not required to do
            #    so.
            master.write("#EXT-X-VERSION:4\n")
            for aidx, audio in enumerate(audios):
                describe = (
                    f'NAME="{options.audio_names[aidx]}",'
                    f"DEFAULT={'YES' if aidx == options.audio_default else 'NO'},"
                    f'AUTOSELECT=YES,CHANNELS="{audio["channels"]}"'
                )
                language = options.audio_languages[aidx]
                if language != "und":
                    describe = f'LANGUAGE="{language}",{describe}'
                if not options.audio_separate:
                    # Without a URI, the track sits in every variant
                    master.write(
                        f'#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="audio",{describe}\n'
                    )
                    continue
                master.writelines(
                    f'#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="{audio_group(gidx)}",'
                    f'{describe},URI="{prefix}'
                    f'{playlists[audio_variants[aidx]]["name"]}"\n'
                    for gidx, prefix in enumerate(options.hls_playlist_prefix)
                )
        else:
            master.write("#EXT-X-VERSION:3\n")
        for idx in playlists:
            if idx in audio_variants.values():
                # This is an audio rendition, not a variant.
                continue
            if not options.audio_only and options.video_bitrates[idx] == 0:
                # We didn't ask for an audio only track but we have
                # one, skip it.
                continue
            codecs = all_codecs.get(idx)
            bandwidth = options.video_bitrates[idx]
            if audios:
                # With separate audio, only one track is fetched
                bandwidth += options.audio_bitrate * (
                    1 if options.audio_separate else len(audios)
                )
            for gidx, prefix in enumerate(options.hls_playlist_prefix):
                master.write(f"#EXT-X-STREAM-INF:BANDWIDTH={bandwidth}000,")
                if options.video_bitrates[idx] > 0:
                    master.write(
                        f'RESOLUTION={playlists[idx]["resolution"]},'
                        f"FRAME-RATE={fps:.3f},"
                    )
                if codecs:
                    master.write(f'CODECS="{codecs}",')
                if audio_media:
                    master.write(f'AUDIO="{audio_group(gidx)}",')
                master.write(
                    f'NAME="{options.video_names[idx]}"\n'
                    f'{prefix}{playlists[idx]["name"]}\n'
                )
        if options.audio_only and options.audio_separate:
            # The audio only variant is the default rendition itself
            vidx = audio_variants[options.audio_default]
            codecs = all_codecs.get(vidx)
            for gidx, prefix in enumerate(options.hls_playlist_prefix):
                master.write(f"#EXT-X-STREAM-INF:BANDWIDTH={options.audio_bitrate}000,")
                if codecs:
                    master.write(f'CODECS="{codecs}",')
                master.write(
                    f'AUDIO="{audio_group(gidx)}",NAME="{options.video_names[vidx]}"\n'
                    f'{prefix}{playlists[vidx]["name"]}\n'
                )

    codecs = None
    if all_codecs and options.mp4:
        codecs = extract_codecs(options, options.mp4_filename)
    mp4_type = f"""'video/mp4; codecs="{codecs}"'""" if codecs else '"video/mp4"'
    poster = f' poster="{options.poster_filename}"' if options.poster else ""
    logger.info(f"""video can be served with:

    <video{poster} controls>
      <source src="index.m3u8" type="application/vnd.apple.mpegurl">""")
    if options.mp4:
        logger.info(f'      <source src="{options.mp4_filename}" type={mp4_type}>')
    if options.chapters and technical["chapters"]:
        logger.info(
            f'      <track kind="chapters" src="{options.chapters_filename}" default>'
        )
    logger.info("    </video>")


if __name__ == "__main__":
    options = parse_args()
    setup_logging(options)

    try:
        # Create output directory
        try:
            logger.debug(f"create directory {options.output}")
            os.makedirs(options.output)
        except FileExistsError:
            if options.output_overwrite:
                logger.info(f"delete existing {options.output}")
                shutil.rmtree(options.output)
                os.makedirs(options.output)
            else:
                raise

        # Change directory
        options.input = os.path.relpath(options.input, options.output)
        os.chdir(options.output)

        # Probe input file
        technical = probe(options)
        if not technical["audios"] and options.audio_only:
            raise RuntimeError(
                f"no audio track in {options.input}, cannot do an audio only variant"
            )
        if not technical["audios"] and options.audio_separate:
            raise RuntimeError(
                f"no audio track in {options.input}, cannot do a separate audio track"
            )

        # Fix options to match input video
        fix_options(options, technical)
        logger.debug("current settings:")
        for k, v in vars(options).items():
            logger.debug(f" {k} = {v}")

        # Generate output files
        poster(options, technical)
        chapters(options, technical)
        transcode(options, technical)

        for f in glob.glob("_*"):
            os.remove(f)

    except Exception as e:
        logger.exception("%s", e)  # noqa: TRY401
        sys.exit(1)
